<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>WebScrapingAI</RootNamespace>
    <AssemblyName>WebScrapingAI</AssemblyName>

    <!-- Package metadata -->
    <PackageId>WebScrapingAI</PackageId>
    <Version>4.0.0</Version>
    <Authors>WebScraping.AI</Authors>
    <Company>WebScraping.AI</Company>
    <Description>Official .NET client for the WebScraping.AI API. Async, zero runtime dependencies, multi-targets netstandard2.0 and net8.0.</Description>
    <Copyright>Copyright (c) 2026 WebScraping.AI</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/webscraping-ai/webscraping-ai-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/webscraping-ai/webscraping-ai-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>webscraping;scraping;api;ai;llm;html;extract</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="WebScrapingAI.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
